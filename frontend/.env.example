# Copy this file to frontend/.env and fill in the values.
# Restart "npm start" after changing it.

# Supabase - sign-up and sign-in.
# Dashboard -> Project Settings -> API Keys. Use the project URL and the PUBLISHABLE key (sb_publishable_...).
# Never put the secret key here: everything in the frontend is visible to anyone.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=

# Local backend:
REACT_APP_API_URL=http://localhost:5000

# If this is not set, the app uses the deployed backend at https://studyscribe.onrender.com
